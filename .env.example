# Gemini API key (optional for offline testing/demo, required for live model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration (optional: if omitted, automatically uses local SQLite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# SQLite database file overrides (defaults to agent.db and lab.db)
# AGENT_DB=agent.db
# LAB_DB=lab.db
